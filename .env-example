# ============================================================
# Copy this file to .env and fill in the values:
#   cp .env-example .env
# ============================================================

# ==== Discord ====
DISCORD_TOKEN=

# ==== OpenRouter ====
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ==== Models ====
# STT
STT_MODEL=
# Language hint for STT, e.g. ru (helps Whisper on short/noisy phrases; empty = auto-detect)
STT_LANG=
# LLM
LLM_MODEL=
# TTS
TTS_MODEL=

# TTS voice. 
TTS_VOICE=
# Audio format from TTS (allowed formats depend on the chosen model)
TTS_FORMAT=mp3
# TTS PCM output sample rate (used only when TTS_FORMAT=pcm)
TTS_SAMPLE_RATE=24000

# ==== LLM Behavior ====
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.7
# How many recent exchanges (question + answer) to remember in each channel
HISTORY_LIMIT=12

# ==== VAD (affect the delay) ====
# A silence of this duration = end of utterance (shorter = faster response, but cuts off pauses more often)
SILENCE_MS=700
# Minimum speech duration to start an utterance (filters out clicks)
MIN_SPEECH_MS=200
# How many milliseconds of audio *before* the start of speech to include at the beginning of the utterance.
PREROLL_MS=300
# Maximum duration of a single utterance (forced truncation)
MAX_UTTERANCE_MS=30000
# webrtcvad sensitivity 0–3 (3 = strictest noise filter)
VAD_AGGRESSIVENESS=2

# ==== Barge-in (interrupting the bot by voice) ====
BARGE_IN=true
# How many milliseconds of continuous speech are needed to interrupt the bot?
BARGE_IN_MIN_MS=350

# ==== Utterance merging (one STT request per speech burst) ====
# Consecutive speech fragments are merged before being sent to STT.
# The merged audio is flushed after this much silence between fragments:
MERGE_GAP_MS=1200
# ...or immediately when the merged audio reaches this length:
MERGE_MAX_MS=12000

# ==== Others ====
# OpenRouter response read timeout, sec
REQUEST_TIMEOUT=60
